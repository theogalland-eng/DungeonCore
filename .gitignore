# ─────────────────────────────────────────────────────────────
#  Dungeon Core — .gitignore en LISTE BLANCHE
#  Tout est ignoré par défaut ; seuls notre code, nos outils, nos
#  données générées et nos propres créations sont publiés.
#  Les packs tiers (craftpix, A* Pathfinding, TextMesh Pro...) restent
#  en local : voir docs/ASSETS.md pour les récupérer.
# ─────────────────────────────────────────────────────────────

/*
!/.gitignore
!/.gitattributes
!/README.md
!/LICENSE
!/docs/
!/Packages/
!/ProjectSettings/
!/Tools~/
!/Assets/

# ── Assets : liste blanche ───────────────────────────────────
/Assets/*
!/Assets/scripts/
!/Assets/scripts.meta
!/Assets/Editor/
!/Assets/Editor.meta
!/Assets/Fonts/
!/Assets/Fonts.meta
!/Assets/Scenes/
!/Assets/Scenes.meta
!/Assets/Prefabs/
!/Assets/Prefabs.meta
!/Assets/animations/
!/Assets/animations.meta
!/Assets/Settings/
!/Assets/Settings.meta
!/Assets/DefaultVolumeProfile.asset
!/Assets/DefaultVolumeProfile.asset.meta
!/Assets/UniversalRenderPipelineGlobalSettings.asset
!/Assets/UniversalRenderPipelineGlobalSettings.asset.meta
!/Assets/InputSystem_Actions.inputactions
!/Assets/InputSystem_Actions.inputactions.meta

# Art : créations PixelLab (générées pour le projet) et relief procédural
!/Assets/Art/
!/Assets/Art.meta
/Assets/Art/*
!/Assets/Art/PixelLab/
!/Assets/Art/PixelLab.meta
# relief du volcan : calculé de zéro par Tools~/make_relief.py
!/Assets/Art/Generated/
!/Assets/Art/Generated.meta
/Assets/Art/Generated/*
!/Assets/Art/Generated/Relief/
!/Assets/Art/Generated/Relief.meta
# terrain de l'île (tuiles auto-raccordées, eau, décors) : Tools~/make_terrain.py
!/Assets/Art/Generated/Terrain/
!/Assets/Art/Generated/Terrain.meta
# objets dessinés pour le projet : Tools~/make_props.py
!/Assets/Art/Generated/Props/
!/Assets/Art/Generated/Traps/
!/Assets/Art/Generated/Traps.meta
# familles de monstres dessinées pour le projet : Tools~/make_creatures.py
# (les voies de rôle dérivées des packs craftpix restent locales : Tools~/make_monster_roles.py)
!/Assets/Art/Characters8/
!/Assets/Art/Characters8.meta
/Assets/Art/Characters8/*
!/Assets/Art/Characters8/spider_*
!/Assets/Art/Characters8/mimic_*
!/Assets/Art/Characters8/bat_*
!/Assets/Art/Characters8/wolf_*
!/Assets/Art/Characters8/salamander_*
!/Assets/Art/Generated/Props.meta
# murs et sols du donjon dessinés pour le projet : Tools~/make_dungeon.py
!/Assets/Art/Generated/Walls/
!/Assets/Art/Generated/Walls.meta
!/Assets/Art/Generated/Dungeon/
!/Assets/Art/Generated/Dungeon.meta

# Resources : catalogue, polices générées (Cinzel, OFL), sons procéduraux, mouette
!/Assets/Resources/
!/Assets/Resources.meta
/Assets/Resources/*
!/Assets/Resources/DungeonCatalog.asset
!/Assets/Resources/DungeonCatalog.asset.meta
!/Assets/Resources/SettlementArt.asset
!/Assets/Resources/SettlementArt.asset.meta
!/Assets/Resources/Fonts/
!/Assets/Resources/Localization/
!/Assets/Resources/Localization.meta
!/Assets/Resources/Fonts.meta
!/Assets/Resources/FX/
!/Assets/Resources/FX.meta
/Assets/Resources/FX/*
!/Assets/Resources/FX/gull_32x32.png
!/Assets/Resources/FX/gull_32x32.png.meta
!/Assets/Resources/FX/javelin.png
!/Assets/Resources/FX/javelin.png.meta
!/Assets/Resources/FX/dart.png
!/Assets/Resources/FX/dart.png.meta
# détails de sol procéduraux, palettes de personnalisation, shader du flash d'impact
!/Assets/Resources/Decals/
!/Assets/Resources/Decals.meta
!/Assets/Resources/HeroPalettes/
!/Assets/Resources/HeroPalettes.meta
!/Assets/Resources/Shaders/
!/Assets/Resources/Shaders.meta
# sons procéduraux + musiques composées par l'auteur avec Gemini Music
!/Assets/Resources/Audio/
!/Assets/Resources/Audio.meta
# icônes pixel de l'interface (Tools~/make_ui_icons.py)
!/Assets/Resources/UI/
!/Assets/Resources/UI.meta
# cadavre d'intrus (Tools~/make_props.py)
!/Assets/Resources/Props/
!/Assets/Resources/Props.meta

# ── Divers ───────────────────────────────────────────────────
*.psd
*.ai
*.eps
.DS_Store
Thumbs.db
__pycache__/
*.pyc
